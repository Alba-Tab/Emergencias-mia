AI_APP_NAME=Emergencias AI API
AI_VERSION=0.2.0
# AI_SERVICE_TOKEN=un-token-largo-entre-servicios
# openrouter (por defecto) o prueba: un analizador sin proveedor real, sin clave ni costo,
# con salidas fijas y válidas. AI_SERVICE_TOKEN sigue siendo obligatorio.
AI_PROVIDER=openrouter
# AI_OPENROUTER_API_KEY=tu-clave
AI_OPENROUTER_MODEL=google/gemini-3.8-flash
# Opcionales: modelo distinto por tarea (si faltan, se usa AI_OPENROUTER_MODEL).
# AI_IMAGE_MODEL=
# AI_AUDIO_MODEL=
# AI_VIDEO_MODEL=
# AI_SUMMARY_MODEL=
AI_PROVIDER_TIMEOUT_SECONDS=90
AI_DOWNLOAD_TIMEOUT_SECONDS=20
AI_MAX_CONCURRENT_MODEL_CALLS=4
AI_IMAGE_MAX_BYTES=10485760
AI_AUDIO_MAX_BYTES=5242880
AI_AUDIO_MAX_SECONDS=120
AI_VIDEO_MAX_BYTES=20971520
AI_VIDEO_MAX_SECONDS=60
# frames (por defecto): fotogramas con su segundo + audio, preparados con ffmpeg; full: el video completo.
AI_VIDEO_MODE=frames
AI_VIDEO_MAX_FRAMES=8
# Puntaje de cambio de escena de ffmpeg (0 a 1) a partir del cual un fotograma se considera nuevo.
AI_VIDEO_SCENE_THRESHOLD=0.3
# Si no se pueden preparar los fotogramas: true envía el video completo; false responde unreadable_media.
AI_VIDEO_FALLBACK_TO_FULL=true
# Timeout de cada proceso de ffprobe/ffmpeg.
AI_FFMPEG_TIMEOUT_SECONDS=10
# Control de silencio (necesita ffmpeg): un audio, o la pista de un video, está en silencio si su pico no llega
# a AI_SILENCE_MAX_VOLUME_DB (dBFS; el silencio digital mide -91) o si lo que supera ese nivel dura menos de
# AI_SILENCE_MIN_AUDIBLE_SECONDS. Un audio en silencio no se envía al modelo; 0 s desactiva el segundo criterio.
AI_SILENCE_MAX_VOLUME_DB=-50
AI_SILENCE_MIN_AUDIBLE_SECONDS=0.3
# Solo para scripts/live_smoke.py; la URL debe prepararla el backend.
# AI_SMOKE_DOWNLOAD_URL=https://almacenamiento.example/objeto?firma=temporal
# AI_SMOKE_SHA256=sha256-hexadecimal-de-64-caracteres
# AI_SMOKE_MIME_TYPE=image/png
